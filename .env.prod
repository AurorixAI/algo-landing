# Public build settings of the production landing (algolab.me).  Only VITE_ values: they end up in the page, never put secrets here.
# «Войти» leads to VITE_APP_URL/login (K3 L7).
VITE_APP_URL=https://app.algolab.me
# Cloudflare Turnstile site key (public).  Empty = no widget; the server then must not require a token.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFrb2QMF6WKq2pnA
