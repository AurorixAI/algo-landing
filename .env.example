# No credentials are needed for a local preview. Empty delivery settings keep it disabled.
# Only VITE_ values are public build-time configuration. Never prefix secrets with VITE_.

# Turnstile: use a widget restricted to your deployed hostnames, action "contact".
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames, without scheme or path (for example: example.com,www.example.com).
TURNSTILE_EXPECTED_HOSTNAMES=

# Exact HTTPS origins allowed to submit, comma-separated, no path/trailing slash.
# Example: https://example.com,https://www.example.com
# Local development permits localhost and 127.0.0.1 on the configured PORT.
CONTACT_ALLOWED_ORIGINS=

# Resend server credentials and a verified sender. No real email is sent without configuration.
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM=

# Deployment site URL; also keep canonical and Open Graph URLs in client/index.html aligned.
SITE_URL=https://example.com
