# The landing is a static site: `vite build --mode prod|stage` reads .env.prod / .env.stage (committed, public values only).
# Local settings that must not be committed go to .env.local (ignored).  Only VITE_ values are public build-time configuration.
# The form's address is relative (/api/v1/public/demo-requests): nginx proxies it to the auth service, nothing to configure here.

# Where «Войти» leads (origin, no path).  Required: the build stops without it.
VITE_APP_URL=https://app.algolab.me
# Cloudflare Turnstile site key (public), widget restricted to the landing hostnames.  The secret key lives only in the
# auth service (TURNSTILE_SECRET_KEY, TURNSTILE_HOSTNAMES).
VITE_TURNSTILE_SITE_KEY=

# Optional: the sha written to <meta name="release">; by default `git rev-parse HEAD` (+ "-dirty" with local changes).
# RELEASE_SHA=
